{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cron",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-26",
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"upload_source_maps": true,
	"placement": {
		"mode": "smart"
	},
	"vars": {},
	"secrets": {
		"required": [
			"CRON_KEY",
		],
	},
}

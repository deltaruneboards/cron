{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cron",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-26",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"upload_source_maps": true,
	"placement": {
		"mode": "smart"
	},
	"vars": {},
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "0c4a1c8a6ef94b67b02db3a067acb435"
		}
	],
	"secrets": {
		"required": [
			"CRON_KEY",
			"MONITORING_WEBHOOK",
		],
	},
}
